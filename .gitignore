# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build and packaging output (lock files such as poetry.lock, uv.lock and Pipfile.lock stay tracked)
build/
dist/
*.egg-info/
.eggs/

# Test, type-check and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local secrets (the example file is the only tracked env file)
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
.idea/
.vscode/

# Shared AI tooling (symlinks to ../ai, never committed)
/CLAUDE.md
/.claude
/.serena/
/graphify-out/
